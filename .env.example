# Copy to .env.local and fill in.
REDIS_URL=redis://default:<password>@<host>:<port>
# Optional: domain used in generated short links (defaults to the site's own address).
# SHORT_LINK_BASE_URL=https://mytools.vercel.app

# Price alerts (Web Push). Generate keys with: npx web-push generate-vapid-keys
NP_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Secret the scheduler sends to /api/alerts/check (any long random string).
CRON_SECRET=
